@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 20 14.3% 4.1%;
    --card: 0 0% 100%;
    --card-foreground: 20 14.3% 4.1%;
    --popover: 0 0% 100%;
    --popover-foreground: 20 14.3% 4.1%;
    --primary: 24 9.8% 10%;
    --primary-foreground: 60 9.1% 97.8%;
    --secondary: 60 4.8% 95.9%;
    --secondary-foreground: 24 9.8% 10%;
    --muted: 60 4.8% 95.9%;
    --muted-foreground: 25 5.3% 44.7%;
    --accent: 60 4.8% 95.9%;
    --accent-foreground: 24 9.8% 10%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 60 9.1% 97.8%;
    --border: 20 5.9% 90%;
    --input: 20 5.9% 90%;
    --ring: 20 14.3% 4.1%;
    --radius: 0.75rem;

    /* Brand colors */
    --amber-warm: #0891b2;
    --amber-light: #cffafe;
    --beige: #f0fbfd;
    --beige-dark: #e0f7fa;
  }
}

@layer base {
  * { @apply border-border; }
  html, body {
    max-width: 100vw;
  }
  /* overflow-x va SOLO su html: mettendolo anche su body, il browser è
     costretto (per spec CSS) a rendere "auto" anche l'overflow-y di body,
     trasformandolo in un secondo contenitore di scroll. Questo rompeva
     "position: sticky" sull'header da desktop, che scompariva scrollando
     invece di restare fisso in alto. */
  html {
    overflow-x: hidden;
  }
  body { 
    @apply bg-background text-foreground;
    background-color: #f0fbfd;
  }
}

/* ===== TEMA HOME/NEGOZIO (riusato su tutte le pagine) ===== */
.theme-page-bg { background: linear-gradient(180deg,#eafbff 0%,#f5fdff 45%,#ffffff 100%); }
.theme-hero { background: linear-gradient(160deg,#dff7fc 0%,#eafbff 55%,#ffffff 100%); }
/* Stesso gradiente scuro immersivo dell'hero della home, riusato come sfondo
   dell'hero di Lotteria/Promo/Volantino/Zone di consegna per dare a tutto il
   sito la stessa identità visiva, non solo alla home. */
.theme-hero-dark { background: linear-gradient(135deg, #04202b 0%, #06303d 30%, #0c2b36 60%, #03131a 100%); }
.glass-card {
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(8,145,178,0.12);
  box-shadow: 0 10px 30px rgba(8,145,178,0.08);
}

/* ===== Liquid glass (bottom nav) =====
   Barra con vetro liquido reale: blur+saturate forte, rim-light sottile,
   riflesso speculare in alto e una "pillola" di vetro che scivola sotto
   la voce attiva con un piccolo overshoot elastico (effetto liquido). */
.liquid-glass-nav {
  position: relative;
  isolation: isolate;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.32) 100%),
    rgba(240,251,253,0.55);
  -webkit-backdrop-filter: blur(22px) saturate(1.8);
  backdrop-filter: blur(22px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.5);
  box-shadow:
    0 10px 32px rgba(8,45,60,0.22),
    0 2px 8px rgba(8,45,60,0.10),
    inset 0 1px 0 rgba(255,255,255,0.85),
    inset 0 0 0 1px rgba(8,145,178,0.06);
}
.liquid-glass-nav::before {
  content: '';
  position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(ellipse 60% 60% at 30% -10%, rgba(255,255,255,0.75), rgba(255,255,255,0) 60%);
  mix-blend-mode: screen;
}
.liquid-glass-pill {
  position: absolute;
  top: 6px; bottom: 6px;
  border-radius: 14px;
  background:
    radial-gradient(ellipse 90% 80% at 30% 15%, rgba(255,255,255,0.95), rgba(255,255,255,0.55) 55%, rgba(255,255,255,0.25) 100%),
    rgba(255,255,255,0.35);
  -webkit-backdrop-filter: blur(6px) saturate(1.3);
  backdrop-filter: blur(6px) saturate(1.3);
  box-shadow:
    0 6px 16px rgba(8,145,178,0.22),
    inset 0 1px 0 rgba(255,255,255,0.95),
    inset 0 0 0 1px rgba(8,145,178,0.15),
    inset 0 -6px 10px -4px rgba(8,145,178,0.18);
  transition: left 0.5s cubic-bezier(0.34,1.56,0.64,1), width 0.5s cubic-bezier(0.34,1.56,0.64,1);
  pointer-events: none;
  z-index: 0;
}

/* ===== Liquid glass — varianti riusabili in altri punti del sito =====
   Stessa "ricetta" della bottom nav (blur+saturate, rim-light, riflesso
   speculare in alto), adattata a due usi diversi: un header sticky, dove
   lo sfondo/colore restano quelli già impostati inline e qui si aggiunge
   solo il rilievo vetroso; e un pannello/card flottante (FloatingMenu,
   modali), dove la ricetta è completa come nella bottom nav. */
.liquid-glass-header {
  /* NIENTE "position" qui: questa classe si usa sempre insieme
     all'utility Tailwind "sticky" sullo stesso elemento (l'header in
     alto). Impostare "position: relative" qui vincerebbe sulla cascata
     (stessa specificita', dichiarata dopo le utility di Tailwind) e
     rompe silenziosamente lo sticky, facendo sparire il menu scorrendo.
     "sticky" crea comunque un contesto di posizionamento valido per lo
     pseudo-elemento ::before qui sotto, quindi non serve altro. */
  isolation: isolate;
  box-shadow:
    0 8px 28px rgba(8,45,60,0.10),
    inset 0 1px 0 rgba(255,255,255,0.6);
}
.liquid-glass-header::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 55% 60% at 25% -30%, rgba(255,255,255,0.5), rgba(255,255,255,0) 60%);
  mix-blend-mode: screen;
}
.liquid-glass-card {
  /* NIENTE "position" qui: questa classe si usa sempre insieme
     all'utility Tailwind "fixed" sullo stesso elemento (i pannelli
     Chat e Account/Punti). Impostare "position: relative" qui
     vincerebbe sulla cascata (stessa specificita', dichiarata dopo le
     utility di Tailwind) e rompe silenziosamente il "fixed": il
     pannello smette di restare ancorato allo schermo e scivola giu'
     nel normale flusso della pagina, in basso a sinistra. "fixed" crea
     comunque un contesto di posizionamento valido per lo
     pseudo-elemento ::before qui sotto, quindi non serve altro. */
  isolation: isolate;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.4) 100%),
    rgba(240,251,253,0.6);
  -webkit-backdrop-filter: blur(22px) saturate(1.8);
  backdrop-filter: blur(22px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.5);
  box-shadow:
    0 16px 40px rgba(8,45,60,0.22),
    0 4px 12px rgba(8,45,60,0.10),
    inset 0 1px 0 rgba(255,255,255,0.85),
    inset 0 0 0 1px rgba(8,145,178,0.06);
}
.liquid-glass-card::before {
  content: '';
  position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(ellipse 60% 50% at 30% -10%, rgba(255,255,255,0.7), rgba(255,255,255,0) 60%);
  mix-blend-mode: screen;
}

/* ===== SCROLLBAR ===== */
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
.scrollbar-hide::-webkit-scrollbar { display: none; }

/* ===== KEYFRAMES ===== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-24px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideInRight {
  from { opacity: 0; transform: translateX(24px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  33% { transform: translateY(-8px) rotate(1deg); }
  66% { transform: translateY(-4px) rotate(-1deg); }
}
@keyframes floatSlow {
  0%, 100% { transform: translateY(0px) rotate(-2deg); }
  50% { transform: translateY(-12px) rotate(2deg); }
}
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}
@keyframes pulse-warm {
  0%, 100% { box-shadow: 0 0 0 0 rgba(8, 145, 178, 0.4); }
  50% { box-shadow: 0 0 0 12px rgba(8, 145, 178, 0); }
}
@keyframes rotate3d {
  0% { transform: perspective(600px) rotateY(0deg); }
  100% { transform: perspective(600px) rotateY(360deg); }
}
@keyframes tilt {
  0%, 100% { transform: perspective(800px) rotateX(0deg) rotateY(0deg); }
  25% { transform: perspective(800px) rotateX(2deg) rotateY(3deg); }
  75% { transform: perspective(800px) rotateX(-2deg) rotateY(-3deg); }
}
@keyframes scroll-indicator {
  0% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(10px); opacity: 0; }
}
@keyframes gradient-shift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}
.animate-breathe { animation: breathe 6s ease-in-out infinite; }

@keyframes bubbleBob {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-5px) scale(1.06); }
}
.animate-bubble-bob { animation: bubbleBob 3.5s ease-in-out infinite; }

@keyframes bubbleRiseSmall {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  15% { opacity: 0.8; }
  80% { opacity: 0.35; }
  100% { transform: translateY(-95px) scale(0.9); opacity: 0; }
}
.animate-bubble-rise-small { animation: bubbleRiseSmall linear infinite; }

@keyframes bubbleRise {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  8% { opacity: 0.9; }
  25% { transform: translate(18px, -28vh) scale(1); }
  50% { transform: translate(-22px, -55vh) scale(1.08); }
  75% { transform: translate(16px, -80vh) scale(0.92); }
  92% { opacity: 0.5; }
  100% { transform: translate(-12px, -110vh) scale(0.65); opacity: 0; }
}
.animate-bubble-rise { animation: bubbleRise linear infinite; }

@keyframes bubblePop {
  0%, 78% { transform: scale(1); opacity: 0.75; }
  88% { transform: scale(1.5); opacity: 0.4; }
  100% { transform: scale(2); opacity: 0; }
}
.animate-bubble-pop { animation: bubblePop ease-in infinite; }

@keyframes bubbleReveal {
  0% { opacity: 0; transform: scale(0.55); filter: blur(10px); }
  55% { opacity: 1; filter: blur(0px); }
  70% { transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1); filter: blur(0px); }
}

@keyframes bubblePopIn {
  0% { opacity: 0; transform: translateY(24px) scale(0.3); }
  55% { opacity: 1; transform: translateY(-6px) scale(1.08); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
.animate-bubble-pop-in { animation: bubblePopIn 0.55s cubic-bezier(0.34,1.56,0.64,1) both; }
.animate-bubble-reveal { animation: bubbleReveal 1.1s cubic-bezier(0.22,1.2,0.36,1) forwards; }

/* ===== Glass / soap bubble realistico (home) =====
   Riusa la stessa logica a layer del site-ticker: base gradient,
   highlight speculare grande in alto a sinistra, rim-light sottile,
   micro-riflesso secondario, e leggero tint colore per l'iridescenza. */
.glass-bubble {
  --tint: rgba(8,145,178,0.32);
  --tint-strong: rgba(8,145,178,0.4);
  position: relative;
  isolation: isolate;
  background:
    radial-gradient(circle at 30% 24%, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.62) 20%, rgba(255,255,255,0.22) 42%, rgba(255,255,255,0.06) 62%, rgba(255,255,255,0) 76%),
    radial-gradient(circle at 76% 80%, var(--tint) 0%, transparent 58%),
    radial-gradient(circle at 50% 96%, rgba(255,255,255,0.5), transparent 45%),
    rgba(255,255,255,0.14);
  box-shadow:
    0 16px 32px -10px rgba(8,45,60,0.28),
    0 4px 10px rgba(8,45,60,0.10),
    inset 0 0 0 1px rgba(255,255,255,0.65),
    inset 0 -14px 20px -6px var(--tint-strong),
    inset 0 12px 18px -4px rgba(255,255,255,0.7);
  -webkit-backdrop-filter: blur(3px) saturate(1.15);
  backdrop-filter: blur(3px) saturate(1.15);
}
.glass-bubble::before {
  content: '';
  position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background: radial-gradient(ellipse 44% 28% at 27% 20%, rgba(255,255,255,0.95), rgba(255,255,255,0) 72%);
  mix-blend-mode: screen;
}
.glass-bubble::after {
  content: '';
  position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  background:
    radial-gradient(ellipse 11% 7% at 80% 74%, rgba(255,255,255,0.9), rgba(255,255,255,0) 78%),
    radial-gradient(circle at 50% 50%, transparent 90%, rgba(255,255,255,0.55) 95%, rgba(255,255,255,0) 100%);
}
.glass-bubble-sparkle {
  position: absolute;
  pointer-events: none;
  color: rgba(255,255,255,0.95);
  filter: drop-shadow(0 0 3px rgba(255,255,255,0.8));
  animation: sparkleTwinkle 2.6s ease-in-out infinite;
}
@keyframes sparkleTwinkle {
  0%, 100% { opacity: 0.25; transform: scale(0.7); }
  50% { opacity: 1; transform: scale(1); }
}
@keyframes bubbleSheen {
  0% { transform: translateX(-120%) rotate(18deg); }
  100% { transform: translateX(220%) rotate(18deg); }
}
.glass-bubble-sheen {
  position: absolute; inset: -20%; border-radius: inherit; pointer-events: none;
  overflow: hidden;
}
.glass-bubble-sheen::before {
  content: '';
  position: absolute; top: 0; left: 0; width: 30%; height: 160%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.55), transparent);
  animation: bubbleSheen 5.5s ease-in-out infinite;
  animation-delay: var(--sheen-delay, 0s);
}
@keyframes cartBounce {
  0% { transform: scale(1) rotate(0deg); }
  30% { transform: scale(1.3) rotate(-12deg); }
  55% { transform: scale(0.9) rotate(8deg); }
  75% { transform: scale(1.15) rotate(-4deg); }
  100% { transform: scale(1) rotate(0deg); }
}
@keyframes badgePop {
  0% { transform: scale(1); }
  40% { transform: scale(1.4); }
  100% { transform: scale(1); }
}
@keyframes skeletonShimmer {
  0% { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}
@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(120px) rotate(540deg); opacity: 0; }
}
@keyframes checkPop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ===== UTILITY ANIMATIONS ===== */
.animate-fade-in-up { animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
.animate-scale-in { animation: scaleIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.animate-slide-in-left { animation: slideInLeft 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.animate-slide-in-right { animation: slideInRight 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.animate-float { animation: float 4s ease-in-out infinite; }
.animate-float-slow { animation: floatSlow 6s ease-in-out infinite; }
.animate-tilt { animation: tilt 8s ease-in-out infinite; }
.animate-spin-slow { animation: spin-slow 12s linear infinite; }
.animate-scroll-indicator { animation: scroll-indicator 1.5s ease-in-out infinite; }
.animate-gradient { 
  background-size: 200% 200%;
  animation: gradient-shift 4s ease infinite;
}
.animate-pulse-warm { animation: pulse-warm 2s ease-in-out infinite; }
.animate-cart-bounce { animation: cartBounce 0.5s cubic-bezier(0.34,1.56,0.64,1); }
.animate-badge-pop { animation: badgePop 0.4s cubic-bezier(0.34,1.56,0.64,1); }
.animate-check-pop { animation: checkPop 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards; }
.skeleton {
  background: linear-gradient(90deg, rgba(8,145,178,0.06) 25%, rgba(8,145,178,0.14) 50%, rgba(8,145,178,0.06) 75%);
  background-size: 800px 100%;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}
.confetti-piece {
  position: absolute;
  animation: confettiFall 1.1s cubic-bezier(0.22,0.61,0.36,1) forwards;
}

/* ===== SCROLL REVEAL ===== */
.reveal-hidden { opacity: 0; transform: translateY(28px); }
.reveal-visible { animation: fadeInUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards; }

/* ===== STAGGER ===== */
.stagger-children > *:nth-child(1) { animation-delay: 0ms; }
.stagger-children > *:nth-child(2) { animation-delay: 50ms; }
.stagger-children > *:nth-child(3) { animation-delay: 100ms; }
.stagger-children > *:nth-child(4) { animation-delay: 150ms; }
.stagger-children > *:nth-child(5) { animation-delay: 200ms; }
.stagger-children > *:nth-child(6) { animation-delay: 250ms; }
.stagger-children > *:nth-child(7) { animation-delay: 300ms; }
.stagger-children > *:nth-child(8) { animation-delay: 350ms; }
.stagger-children > *:nth-child(9) { animation-delay: 400ms; }
.stagger-children > *:nth-child(10) { animation-delay: 450ms; }

/* ===== 3D CARD ===== */
.card-3d {
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
  transform-style: preserve-3d;
  will-change: transform;
}
.card-3d:hover {
  transform: perspective(800px) translateY(-8px) rotateX(4deg) rotateY(-2deg) scale(1.02);
  box-shadow: 0 25px 50px rgba(8, 145, 178, 0.15), 0 8px 20px rgba(0,0,0,0.08);
}

/* ===== SEARCH BAR GLOW ===== */
@keyframes search-glow-pulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(34,211,238,0.15), 0 4px 16px rgba(8,145,178,0.18); }
  50% { box-shadow: 0 0 0 6px rgba(34,211,238,0.22), 0 6px 22px rgba(8,145,178,0.28); }
}
.search-glow:focus {
  animation: search-glow-pulse 2s ease-in-out infinite;
}

/* ===== NEON GLOW ===== */
@keyframes neon-pulse {
  0%, 100% {
    box-shadow:
      0 0 6px rgba(34,211,238,0.55),
      0 0 16px rgba(34,211,238,0.35),
      0 0 32px rgba(8,145,178,0.22),
      inset 0 0 10px rgba(34,211,238,0.06);
  }
  50% {
    box-shadow:
      0 0 10px rgba(34,211,238,0.9),
      0 0 26px rgba(34,211,238,0.6),
      0 0 48px rgba(8,145,178,0.4),
      inset 0 0 14px rgba(34,211,238,0.14);
  }
}
.neon-glow {
  animation: neon-pulse 2.6s ease-in-out infinite;
}
.neon-glow:hover {
  animation-duration: 1.1s;
}

@keyframes neon-pulse-pink {
  0%, 100% { box-shadow: 0 0 6px rgba(244,114,182,0.55), 0 0 16px rgba(244,114,182,0.35), 0 0 30px rgba(244,114,182,0.2); }
  50% { box-shadow: 0 0 10px rgba(244,114,182,0.9), 0 0 24px rgba(244,114,182,0.6), 0 0 42px rgba(244,114,182,0.35); }
}
.neon-glow-pink { animation: neon-pulse-pink 2.6s ease-in-out infinite; }
.neon-glow-pink:hover { animation-duration: 1.1s; }

@keyframes neon-pulse-white {
  0%, 100% { box-shadow: 0 0 6px rgba(229,229,229,0.5), 0 0 16px rgba(229,229,229,0.3), 0 0 30px rgba(229,229,229,0.15); }
  50% { box-shadow: 0 0 10px rgba(255,255,255,0.85), 0 0 24px rgba(229,229,229,0.55), 0 0 42px rgba(229,229,229,0.3); }
}
.neon-glow-white { animation: neon-pulse-white 2.6s ease-in-out infinite; }
.neon-glow-white:hover { animation-duration: 1.1s; }

@keyframes neon-pulse-green {
  0%, 100% { box-shadow: 0 0 6px rgba(74,222,128,0.55), 0 0 16px rgba(74,222,128,0.35), 0 0 30px rgba(74,222,128,0.2); }
  50% { box-shadow: 0 0 10px rgba(74,222,128,0.9), 0 0 24px rgba(74,222,128,0.6), 0 0 42px rgba(74,222,128,0.35); }
}
.neon-glow-green { animation: neon-pulse-green 2.6s ease-in-out infinite; }
.neon-glow-green:hover { animation-duration: 1.1s; }

@keyframes neon-pulse-blue {
  0%, 100% { box-shadow: 0 0 6px rgba(96,165,250,0.55), 0 0 16px rgba(96,165,250,0.35), 0 0 30px rgba(96,165,250,0.2); }
  50% { box-shadow: 0 0 10px rgba(96,165,250,0.9), 0 0 24px rgba(96,165,250,0.6), 0 0 42px rgba(96,165,250,0.35); }
}
.neon-glow-blue { animation: neon-pulse-blue 2.6s ease-in-out infinite; }
.neon-glow-blue:hover { animation-duration: 1.1s; }

/* ===== SHIMMER TEXT ===== */
.text-shimmer {
  background: linear-gradient(90deg, #155e75, #0891b2, #06b6d4, #0891b2, #155e75);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3s linear infinite;
}

/* ===== GLASS ===== */
.glass {
  background: rgba(240, 251, 253, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(8, 145, 178, 0.1);
}
.glass-dark {
